.program xgo_scripted
; TX FIFO supplies one 12-bit active-low transaction mask per host poll.
; Bit 0=R ... bit 11=RIGHT. A '1' means sink DATA low (pressed).
.wrap_target
    wait 0 pin 0
    wait 1 pin 0
    pull block
    set x, 11
bitloop:
    out pindirs, 1
    jmp x-- more
    set pindirs, 0
    jmp wrap_target
more:
    wait 0 gpio 26
    set pindirs, 0
    wait 1 gpio 26
.wrap
